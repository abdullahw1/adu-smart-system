# Browser traffic stays on the app's own origin; never set camera credentials
# or a raw go2rtc URL in NEXT_PUBLIC_* variables.
GO2RTC_API_URL=http://127.0.0.1:1984
GO2RTC_RTSP_URL=rtsp://127.0.0.1:8554
# Set to the exact external HTTPS URL when deploying with Tailscale Serve.
# APP_ORIGIN=https://adu.your-tailnet.ts.net
# HOST=127.0.0.1
# APP_DATA_DIR=/absolute/path/to/app-data
# RECORDINGS_DIR=/absolute/path/to/recordings
# REQUIRE_RECORDING_MOUNT=1
# RECORDING_MAX_BYTES=107374182400
# RECORDING_MIN_FREE_BYTES=1073741824
# FRIGATE_API_URL=http://127.0.0.1:5000
