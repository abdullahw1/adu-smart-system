# Real configs with credentials — never commit these
frigate/config.yml
.env
*.env

# Frigate runtime data
frigate/media/
frigate/exports/

# Detection-only Frigate: keep config.yml, ignore its database/caches
frigate-detect/config/*
!frigate-detect/config/config.yml

# Mosquitto runtime data
mosquitto/data/

# Node / Next.js (v2)
node_modules/
.next/
*.tsbuildinfo

# Python / FastAPI (v2)
__pycache__/
*.pyc
.venv/

# OS junk
.DS_Store

# App runtime data, per install: camera display names, on-demand recordings
frontend/data/

# Production runtime and isolated build output
runtime/
frontend/.build/
frontend/.test-next/

# Dev stack: demo footage shows real people; Frigate dev runtime data
demo/media/
demo/frigate/*
!demo/frigate/config.yml
.next-dev/

# Face recognition data (biometric): the face library, its ids, photos and
# sheets stay on this machine only. runtime/ above already covers the default
# locations; these rules keep them ignored even if that rule changes or a
# library is pointed somewhere else (FACES_DIR / DATA).
runtime/faces/
runtime/faces-*/
faces.sqlite
faces.sqlite-*
**/thumbs/face_*/
**/known/*/
# App data for a second dev copy of the app (APP_DATA_DIR=data-dev): sessions
# and face decisions
frontend/data-dev/
