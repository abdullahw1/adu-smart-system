[Unit]
Description=ADU camera recording system
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/surveillance
BindsTo=mnt-surveillance.mount

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=/opt/adu-smart-system
ExecStartPre=/bin/sh /opt/adu-smart-system/deploy/check-mount.sh
ExecStart=/usr/bin/docker compose up --abort-on-container-exit
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
